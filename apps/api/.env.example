# ==============================================================================
# Rental Business Software - NestJS API (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` for local development:
#    cp .env.example .env
# 2. Fill in the required database and Supabase credentials.
# 3. CRITICAL SECURITY: NEVER commit `.env`, secret keys, or service role keys!
# ==============================================================================

# Fastify Server Port
PORT=8080

# PostgreSQL Connection String (Connect as rental_app role, NEVER as superuser/postgres)
# Local: postgresql://rental_app:postgres@127.0.0.1:54322/postgres
# Hosted Pooler: postgresql://rental_app.<project-ref>:<db-password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://rental_app:postgres@127.0.0.1:54322/postgres

# Supabase Project URL (Used for JWKS identity verification and storage)
# Local: http://127.0.0.1:54321
# Hosted: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Supabase Service Role Secret Key (Server-side storage & administration only - DO NOT EXPOSE TO FRONTEND)
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key_here

# Payment Webhook Secret (HMAC signature verification for payment webhooks)
PAYMENT_WEBHOOK_SECRET=sandbox-secret

# (Optional) Admin Database URL - Used strictly for automated integration test cleanup
TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
