# ==============================================================================
# Rental Business Software - Owner Web Portal (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` for local development:
#    cp .env.example .env.local
# 2. Fill in the values below.
# 3. NEVER commit `.env.local` or any production secret keys to version control!
# ==============================================================================

# Backend REST API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Supabase Project URL (Local: http://127.0.0.1:54321 | Cloud: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon / Publishable Key (Safe for browser client usage)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_dev_key
